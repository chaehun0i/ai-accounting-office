# Local development placeholders only. Copy to .env at repository root.
APP_ENVIRONMENT=local
POSTGRES_DB=accounting_office
POSTGRES_USER=accounting_local
POSTGRES_PASSWORD=local_placeholder_change_me
POSTGRES_PORT=5432
REDIS_PORT=6379
# Update URLs as well when ports/user/password/database change (URL-encode credentials).
POSTGRES_URL=postgresql://accounting_local:local_placeholder_change_me@localhost:5432/accounting_office
REDIS_URL=redis://localhost:6379/0
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
# Reserved browser API origin; shell does not make API requests yet.
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000
