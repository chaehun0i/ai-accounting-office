# 로컬 개발용 예시 값입니다. 저장소 루트의 .env 파일로 복사해 사용하세요.
APP_ENVIRONMENT=local
POSTGRES_DB=accounting_office
POSTGRES_USER=accounting_local
POSTGRES_PASSWORD=local_placeholder_change_me
POSTGRES_PORT=5432
REDIS_PORT=6379
# 포트·사용자·비밀번호·DB 이름을 바꾸면 URL도 수정하세요. 로그인 정보는 URL 인코딩하세요.
POSTGRES_URL=postgresql://accounting_local:local_placeholder_change_me@localhost:5432/accounting_office
REDIS_URL=redis://localhost:6379/0
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
# 향후 브라우저 API 요청에 사용할 주소입니다. 현재 초기 화면에서는 사용하지 않습니다.
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000

# PostgreSQL 통합 검사에는 별도의 _test DB를 만든 뒤 OS 환경변수로 설정하세요.
# TEST_POSTGRES_URL=postgresql://accounting_local:local_placeholder_change_me@localhost:5432/accounting_foundation_test
